# ============================================================================
# UNIA Frontend Environment Variables - DEVELOPMENT
# ============================================================================
# This file is automatically created for development environments.
# Modify as needed for your local setup.
# ============================================================================

# ============================================================================
# Development / Debug Configuration
# ============================================================================
# Node environment - explicitly set to development
NODE_ENV=development

# Enable verbose logging in development
DEBUG=true

# ============================================================================
# Solana Program Configuration
# ============================================================================
# Program ID for the UNIA token program
# Can be overridden for testing or when migrating to a new program deployment
NEXT_PUBLIC_PROGRAM_ID=B2zocFnLGMryMTt3iBEtezDGqiCQJygc2iXBMYnkDfx2

# Legacy variable (still supported for backward compatibility)
# NEXT_PUBLIC_UNIA_PROGRAM_ID=B2zocFnLGMryMTt3iBEtezDGqiCQJygc2iXBMYnkDfx2

# ============================================================================
# Database Provider Configuration (Development)
# ============================================================================
# Using 'sqlite' for local development (recommended for dev environments)
# Options: 'sqlite' (local development), 'supabase' (production), or 'turso' (libSQL cloud)

# Server-side database provider (more secure, recommended)
DB_PROVIDER=sqlite

# Client-side database adapter selection (fallback for browser)
NEXT_PUBLIC_DB_ADAPTER=sqlite

# ============================================================================
# SQLite Configuration (for local development)
# ============================================================================
# Path to the SQLite database file (default: .data/equa.sqlite)
SQLITE_DB_PATH=.data/equa.sqlite

# ============================================================================
# Oracle / Price Feed Configuration
# ============================================================================
# Enable/disable Pyth Network Hermes price feeds
# When disabled, the app will skip Hermes API calls and use fallback prices
# Useful for development or when Pyth is experiencing issues
NEXT_PUBLIC_ENABLE_PYTH=true

# ============================================================================
# Network Configuration (Development - Devnet)
# ============================================================================
# Solana RPC endpoint (defaults to devnet public RPC)
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# Network environment (devnet for development)
NEXT_PUBLIC_NETWORK=devnet

# ============================================================================
# Rate Limiting Configuration (optional)
# ============================================================================
# Rate limit window in milliseconds (default: 24 hours)
# NEXT_PUBLIC_RATE_LIMIT_WINDOW_MS=86400000

# Maximum referrals per rate limit window (default: 10)
# NEXT_PUBLIC_REFERRAL_RATE_LIMIT=10

# ============================================================================
# FX Exchange Rate API Configuration (Development)
# ============================================================================
# Using ExchangeRate-API free tier for development
NEXT_PUBLIC_FX_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# ============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================================================
# For production environments:
# 1. Change NODE_ENV=production
# 2. Use DB_PROVIDER=turso or supabase
# 3. Set appropriate TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
# 4. Configure custom RPC endpoint for better rate limits
# 5. Review and update all security-related settings
# ============================================================================
