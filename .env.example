# EQUA Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# Solana Program Configuration
# ============================================================================
# Program ID for the EQUA token program (can override for testing or migrations)
# NEW Program ID (current backend deployment):
NEXT_PUBLIC_PROGRAM_ID=7QYUbC1YUdJB2uYcmxqccrokowKroiAYGE5kqC6MaFdP

# Legacy variable name (still supported for backward compatibility):
# NEXT_PUBLIC_EQUA_PROGRAM_ID=7QYUbC1YUdJB2uYcmxqccrokowKroiAYGE5kqC6MaFdP

# ============================================================================
# Network Configuration
# ============================================================================
# Solana RPC endpoint (defaults to devnet public RPC)
# NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# Network environment (devnet, testnet, mainnet-beta)
# NEXT_PUBLIC_NETWORK=devnet

# ============================================================================
# Database Configuration (Turso Only)
# ============================================================================
# Only Turso (libSQL) is supported for database operations
# For local development: use `turso dev` command
# For production: use Turso Cloud (https://turso.tech)

# Turso Database URL (required)
# Local development: http://127.0.0.1:8080 (or your turso dev port)
# Production: libsql://your-db.turso.io
TURSO_DATABASE_URL=http://127.0.0.1:8080

# Turso Auth Token (optional for local dev, required for cloud)
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# IMPORTANT: This database stores NO PII (Personally Identifiable Information)
# - User registration verification is done ON-CHAIN only
# - Database is used for anonymous analytics and statistics only
# - No wallet addresses or user-identifying information is stored

# ============================================================================
# Oracle / Price Feed Configuration
# ============================================================================
# Enable/disable Pyth Network Hermes price feeds
# NEXT_PUBLIC_ENABLE_PYTH=true

# ============================================================================
# Rate Limiting Configuration (optional)
# ============================================================================
# NEXT_PUBLIC_RATE_LIMIT_WINDOW_MS=86400000  # 24 hours in milliseconds
# NEXT_PUBLIC_REFERRAL_RATE_LIMIT=10          # Max referrals per 24h
