# EQUA Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Solana Program Configuration
# Program ID for the EQUA token program (can override for testing or migrations)
# NEXT_PUBLIC_EQUA_PROGRAM_ID=7QYUbC1YUdJB2uYcmxqccrokowKroiAYGE5kqC6MaFdP

# Database Provider Configuration
# Options: 'sqlite' (local development), 'supabase' (production), or 'turso' (libSQL cloud)
# Default: 'sqlite' for development, 'supabase' for production if credentials are set
DB_PROVIDER=sqlite

# SQLite Configuration (for local development)
# Path to the SQLite database file (default: .data/equa.sqlite)
# SQLITE_DB_PATH=.data/equa.sqlite

# Supabase Configuration (for production)
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Turso Configuration (for libSQL cloud database)
# Get these from your Turso project: https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Rate Limiting Configuration (optional)
# NEXT_PUBLIC_RATE_LIMIT_WINDOW_MS=86400000  # 24 hours in milliseconds
# NEXT_PUBLIC_REFERRAL_RATE_LIMIT=10          # Max referrals per 24h
