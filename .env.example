# UNIYAA Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# Solana Program Configuration
# ============================================================================
# Program ID for the UNIYAA token program
# UNIYAA uses Token-2022 (Token Extensions) program ONLY
# Current backend deployment:
NEXT_PUBLIC_PROGRAM_ID=HFg64becVHyoFuHaLVHEVa7cpG6ejyQztDi8zMh4kLSK

# Legacy variable name (still supported for backward compatibility):
# NEXT_PUBLIC_UNIYAA_PROGRAM_ID=HFg64becVHyoFuHaLVHEVa7cpG6ejyQztDi8zMh4kLSK

# Token Program: Token-2022 (TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb)
# This is hardcoded in the frontend and cannot be changed.
# Mint PDA seed: "uniyaa-mint" derived under the program above

# ============================================================================
# Network Configuration
# ============================================================================
# Solana RPC endpoint (defaults to devnet public RPC if not specified)
# Override this for custom RPC providers to avoid rate limiting
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# --- UNIYAA mesh gateway (M13 cut-over) -------------------------------------
# To route reads through a local UNIYAA node (mesh-cached getBalance /
# getAccountInfo / getMultipleAccounts; everything else passes through to
# the configured upstream) start a uniyaa-cli node with:
#   uniyaa start \
#     --rpc-listen 127.0.0.1:7788 \
#     --validator-rpc-upstream https://api.devnet.solana.com
# then set:
#   NEXT_PUBLIC_RPC_ENDPOINT=http://127.0.0.1:7788
#
# Per the M11 architecture rule, the gateway is opt-in. Phones (no
# --validator-rpc-upstream) will return MethodNotFound for write
# methods — see docs/UNIYAA_GATEWAY.md for the full tier story.
# ----------------------------------------------------------------------------

# Network environment (devnet, testnet, mainnet-beta)
NEXT_PUBLIC_NETWORK=devnet

# ============================================================================
# Oracle / Price Feed Configuration
# ============================================================================
# Enable/disable Pyth Network Hermes price feeds
# NEXT_PUBLIC_ENABLE_PYTH=true

# Pyth Network environment (mainnet-beta or devnet)
# Determines which price feed network to use
# NEXT_PUBLIC_PYTH_ENV=mainnet-beta

# ============================================================================
# Rate Limiting Configuration (optional)
# ============================================================================
# NEXT_PUBLIC_RATE_LIMIT_WINDOW_MS=86400000  # 24 hours in milliseconds
# NEXT_PUBLIC_REFERRAL_RATE_LIMIT=10          # Max referrals per 24h
#
# Server-side per-IP rate limit on Netlify Functions is enforced by
# netlify/functions/lib/rateLimit.ts (uses Netlify Blobs). Defaults:
# - Admin POSTs (add/remove-business-referrer): 30 req/min/IP
# - Public GETs (list-business-users, get-fx-rates, get-eqx-history,
#   get-performance-data, referral-rate-limit): 60-120 req/min/IP
# Override values are inline in each function; no env vars required.

# ============================================================================
# Mint Cooldown Configuration
# ============================================================================
# Cooldown period between mints in seconds (default: 86400 = 24 hours)
NEXT_PUBLIC_MINT_COOLDOWN_SECONDS=86400

# ============================================================================
# Netlify Scheduled Functions Configuration
# ============================================================================
# These variables are required for Netlify scheduled functions that update
# on-chain oracles and fetch pricing data. Configure these in Netlify Dashboard
# under Site Settings → Environment Variables.

# Required: Solana RPC endpoint for scheduled functions
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

# Required: Solana network (devnet, testnet, mainnet-beta)
SOLANA_NETWORK=devnet

# Required: Admin wallet private key (base58 encoded)
# SECURITY: Never commit this to version control!
# Generate using: solana-keygen new --no-bip39-passphrase --outfile admin-keypair.json
# Then encode to base58 for Netlify environment variables
# See docs/NETLIFY_DEPLOYMENT.md for detailed instructions
# SOLANA_WALLET_PRIVATE_KEY=<your-base58-encoded-private-key>

# Optional: ExchangeRate API key (for FX rates)
# Get free key at: https://www.exchangerate-api.com/
# If not provided, falls back to free tier endpoint
# EXCHANGERATE_API_KEY=<your-api-key>

# Optional: Netlify Blobs manual configuration (usually auto-detected)
# Only needed if deploying outside Netlify environment or if auto-config fails
# NETLIFY_SITE_ID=<your-site-id>
# NETLIFY_ACCESS_TOKEN=<your-access-token>

