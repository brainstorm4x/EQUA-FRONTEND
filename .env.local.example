# EQUA Token Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Solana Network Configuration
# Options: mainnet-beta, devnet, testnet, localnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC Endpoint
# Use a custom RPC endpoint for better performance
# Examples:
# - Alchemy: https://solana-devnet.g.alchemy.com/v2/YOUR_API_KEY
# - QuickNode: https://YOUR-ENDPOINT.solana-devnet.quiknode.pro/YOUR-API-KEY/
# - Helius: https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# - Default Devnet: https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# EQUA Program ID
# The deployed program address on Solana
NEXT_PUBLIC_EQUA_PROGRAM_ID=G6yZUuyumRxcKbvWjaDVURJzShfeBW1zpde1BHzCr6si

# Feature Flags
# Enable or disable features in the application
NEXT_PUBLIC_ENABLE_REFERRALS=false
NEXT_PUBLIC_ENABLE_TRANSFERS=false
NEXT_PUBLIC_ENABLE_STAKING=false

# Analytics (Optional)
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# Sentry Error Tracking (Optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Development Settings
# Show debug information in development mode
NEXT_PUBLIC_DEBUG_MODE=false

# API Keys for Development Tools (Optional)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Environment
NODE_ENV=development
