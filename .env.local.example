# ============================================================================
# UNIYAA Frontend Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values.
#
# NOTE: This file covers client/dev config only. Server-side admin secrets
# (ADMIN_PRIVATE_KEY, ADMIN_API_TOKEN, ADMIN_ALLOWED_ORIGINS, TURSO_*) belong
# in `.env.example` and are configured in the Netlify dashboard, NOT here.
# ============================================================================

# ============================================================================
# Solana Program Configuration
# ============================================================================
# Program ID for the UNIYAA token program
# Can be overridden for testing or when migrating to a new program deployment
NEXT_PUBLIC_PROGRAM_ID=D158AFttmzAYsbDhHZjqNbJbda8x8pUceucw5QZELDzw

# Legacy variable (still supported for backward compatibility)
# NEXT_PUBLIC_UNIYAA_PROGRAM_ID=D158AFttmzAYsbDhHZjqNbJbda8x8pUceucw5QZELDzw

# ============================================================================
# Database Provider Configuration
# ============================================================================
# Options: 'sqlite' (local development), 'supabase' (production), or 'turso' (libSQL cloud)
# Default: 'sqlite' for development, 'supabase' for production if credentials are set

# Client-side database adapter selection
NEXT_PUBLIC_DB_ADAPTER=turso

# Server-side database provider (more secure, recommended)
DB_PROVIDER=turso

# ============================================================================
# SQLite Configuration (for local development)
# ============================================================================
# Path to the SQLite database file (default: .data/uniyaa.sqlite)
# SQLITE_DB_PATH=.data/uniyaa.sqlite

# ============================================================================
# Supabase Configuration (for production)
# ============================================================================
# Get these from your Supabase project settings at https://app.supabase.com
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# Turso Configuration (for libSQL cloud database)
# ============================================================================
# Get these from your Turso project: https://turso.tech
# 
# For local development (no auth token needed):
#   NEXT_PUBLIC_TURSO_DATABASE_URL=libsql://127.0.0.1:8080
#   NEXT_PUBLIC_TURSO_AUTH_TOKEN=
#
# For production (use Turso Cloud):
#   NEXT_PUBLIC_TURSO_DATABASE_URL=libsql://your-db.turso.io
#   NEXT_PUBLIC_TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Client-side Turso config (accessible in browser)
NEXT_PUBLIC_TURSO_DATABASE_URL=libsql://127.0.0.1:8080
NEXT_PUBLIC_TURSO_AUTH_TOKEN=

# Server-side Turso config (more secure, recommended for production)
TURSO_DATABASE_URL=libsql://127.0.0.1:8080
TURSO_AUTH_TOKEN=

# ============================================================================
# Oracle / Price Feed Configuration
# ============================================================================
# Enable/disable Pyth Network Hermes price feeds
# When disabled, the app will skip Hermes API calls and use fallback prices
# Useful for development or when Pyth is experiencing issues
NEXT_PUBLIC_ENABLE_PYTH=true

# ============================================================================
# Rate Limiting Configuration (optional)
# ============================================================================
# Rate limit window in milliseconds (default: 24 hours)
# NEXT_PUBLIC_RATE_LIMIT_WINDOW_MS=86400000

# Maximum referrals per rate limit window (default: 10)
# NEXT_PUBLIC_REFERRAL_RATE_LIMIT=10

# ============================================================================
# Network Configuration
# ============================================================================
# Solana RPC endpoint (defaults to devnet public RPC if not specified)
# Override this for custom RPC providers to avoid rate limiting
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# --- UNIYAA mesh gateway (M13 cut-over) -------------------------------------
# To route reads through a local UNIYAA node (mesh-cached getBalance /
# getAccountInfo / getMultipleAccounts; everything else passes through to
# the configured upstream) start a uniyaa-cli node with:
#   uniyaa start \
#     --rpc-listen 127.0.0.1:7788 \
#     --validator-rpc-upstream https://api.devnet.solana.com
# then set:
#   NEXT_PUBLIC_RPC_ENDPOINT=http://127.0.0.1:7788
#
# See docs/UNIYAA_GATEWAY.md for the full tier story.
# ----------------------------------------------------------------------------

# Network environment (devnet, testnet, mainnet-beta)
NEXT_PUBLIC_NETWORK=devnet

# ============================================================================
# Development / Debug Configuration (optional)
# ============================================================================
# Enable verbose logging in development
# DEBUG=true

# Node environment (automatically set by Next.js)
# NODE_ENV=development

# ============================================================================
# FX Exchange Rate API Configuration
# ============================================================================
# Primary FX rate API endpoint (default: ExchangeRate-API free tier)
# Free tier limits: 1,500 requests/month, daily updates
# For paid APIs (e.g., Fixer.io, Open Exchange Rates), update URL and add API key
NEXT_PUBLIC_FX_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Fallback FX rate API endpoint (optional, defaults to same as primary)
# NEXT_PUBLIC_FX_API_FALLBACK_URL=https://api.exchangerate-api.com/v4/latest/USD

# API Key for paid FX rate services (optional, not needed for ExchangeRate-API free tier)
# NEXT_PUBLIC_FX_API_KEY=your-api-key-here
