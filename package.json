{
  "name": "uniyaa-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "NODE_ENV=development next dev -p 3000",
    "prebuild": "rm -rf .next",
    "build": "bash scripts/check-app-directory.sh && bash scripts/check-spl-decoder-usage.sh && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:structure": "bash scripts/check-app-directory.sh",
    "check:imports": "bash scripts/check-token-imports.sh",
    "check:spl-decoder": "bash scripts/check-spl-decoder-usage.sh",
    "validate": "bash scripts/check-token-imports.sh && bash scripts/check-spl-decoder-usage.sh && node scripts/validate_registration.mjs",
    "audit:ci": "npm audit --audit-level=critical --omit=dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:functions": "node --test \"netlify/__tests__/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@libsql/client": "^0.17.0",
    "@netlify/blobs": "^8.1.0",
    "@netlify/functions": "^2.8.2",
    "@solana-mobile/wallet-adapter-mobile": "^2.2.5",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "5.56.2",
    "@types/qrcode": "^1.5.6",
    "bs58": "^5.0.0",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "jsqr": "^1.4.0",
    "next": "16.3.8",
    "pino-pretty": "^13.1.2",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.23.8",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.14",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.5",
    "typescript": "5.6.3"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
