{
  "name": "equa-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "bash scripts/check-app-directory.sh && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:structure": "bash scripts/check-app-directory.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:setup": "npx ts-node --esm scripts/db-setup.ts",
    "test:db": "DB_PROVIDER=sqlite jest --testPathPattern=__tests__/db"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.98.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "5.56.2",
    "axios": "^1.7.7",
    "clsx": "2.1.1",
    "jsqr": "^1.4.0",
    "next": "14.2.33",
    "pino-pretty": "^13.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "10.4.20",
    "better-sqlite3": "^12.5.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.33",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "ts-jest": "^29.4.5",
    "typescript": "5.6.3"
  }
}
